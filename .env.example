# Eye of Sauron configuration. Copy to .env and adjust. Never commit .env.
# Variables use the EOS_ prefix. The old FEEDWARDEN_ names (from before 1.1) are still read as a fallback.

# Initial admin account (only used when the database has no users yet).
# If no password is given, a random one is written to /data/initial_admin_password.txt
EOS_ADMIN_USER=admin
# EOS_ADMIN_PASSWORD=change-me-to-a-long-passphrase
# EOS_ADMIN_PASSWORD_FILE=/run/secrets/eos_admin_password

# Encryption key for stored credentials (social accounts, webhook secrets). Fernet key(s), comma-separated:
# the FIRST encrypts, all decrypt (rotation). Generate: python -m app.cli gen-secret-key
# If unset, a key is generated in /data/secret.key - fine for a start, but a key stored next to the
# database does not protect a stolen backup. Prefer the _FILE variant with a Docker secret.
# EOS_SECRET_KEY_FILE=/run/secrets/eos_secret_key

# Where users can download this instance's source code (shown in Settings → About).
# The AGPL requires this if you run a MODIFIED version for other people over a network.
# EOS_SOURCE_URL=https://github.com/your-account/eye-of-sauron

# CVE tracking: optional free NVD API key (https://nvd.nist.gov/developers/request-an-api-key).
# Without it syncing is limited to 5 requests / 30 s (first back-fill takes a few minutes).
# EOS_NVD_API_KEY=
# EOS_NVD_API_KEY_FILE=/run/secrets/nvd_api_key

# SSRF protection: feeds/webhooks on private/LAN addresses are blocked by default.
# Enable only if you need to subscribe to internal feeds or send webhooks to LAN services (n8n, HA).
# EOS_ALLOW_PRIVATE_WEBHOOKS also covers social "webhook" channels and self-hosted Mastodon/Bluesky.
EOS_ALLOW_PRIVATE_FEEDS=false
# Narrower: let only these exact host:port pairs be local/private (e.g. a self-hosted RSSHub bridge).
# EOS_PRIVATE_ALLOWLIST=127.0.0.1:1200
EOS_ALLOW_PRIVATE_WEBHOOKS=false

# Session cookie "Secure" flag: auto (Secure when request is HTTPS), true, false
EOS_COOKIE_SECURE=auto
EOS_SESSION_IDLE_HOURS=24
EOS_SESSION_MAX_DAYS=14

# Restrict accepted Host headers (comma-separated), e.g. feeds.home.lan,feeds.example.com
EOS_ALLOWED_HOSTS=*

# Reverse proxy: IP(s) allowed to set X-Forwarded-For / X-Forwarded-Proto (uvicorn setting)
# FORWARDED_ALLOW_IPS=172.20.0.2

# Fetching
EOS_FETCH_TIMEOUT=20
EOS_FETCH_CONCURRENCY=6
EOS_MAX_FEED_BYTES=10485760

EOS_LOG_LEVEL=INFO
TZ=UTC
