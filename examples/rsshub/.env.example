# RSSHub settings. Copy to .env (never commit .env).
#
# X / Twitter: RSSHub reads X with the session cookie of a logged-in account.
#   - Use a spare account: X may lock or suspend accounts used this way, and the token gives full access to it.
#   - Get it: log in to x.com in a browser -> developer tools -> Application/Storage -> Cookies -> https://x.com
#     -> copy the value of "auth_token".
#   - Paste it after the = below (several tokens can be comma-separated). Restart: docker compose up -d
TWITTER_AUTH_TOKEN=

# Optional: require a key on every RSSHub request (then add ?key=... in the Eye of Sauron bridge address).
# ACCESS_KEY=
